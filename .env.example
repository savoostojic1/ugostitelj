NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Hourly calendar sync via external cron (e.g. cron-job.org)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=generate-a-long-random-string

# Bot protection (Cloudflare Turnstile). Leave empty to disable locally.
# Create a widget at dash.cloudflare.com → Turnstile; add hostvia.me + localhost.
# Also paste the secret into Supabase → Authentication → Attack Protection → CAPTCHA (Turnstile).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
