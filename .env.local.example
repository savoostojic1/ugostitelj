NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase → Authentication → URL Configuration → Redirect URLs (add each):
# http://localhost:3000/auth/callback/recovery
# https://www.hostvia.me/auth/callback/recovery

# Public site (production) — NEXT_PUBLIC_APP_URL also works if you already use that on Vercel
NEXT_PUBLIC_SITE_URL=https://www.hostvia.me
NEXT_PUBLIC_BOOKING_DOMAIN=hostvia.me
# Subdomains auto-enable when SITE_URL is hostvia.me. Set false to force /host/… paths:
# NEXT_PUBLIC_BOOKING_USE_SUBDOMAIN=false

# Hourly calendar sync via external cron (e.g. cron-job.org)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=generate-a-long-random-string

# PWA push notifications (booking inquiries on installed app)
# Generate: npx web-push generate-vapid-keys
# Only NEXT_PUBLIC_VAPID_PUBLIC_KEY is required (VAPID_PUBLIC_KEY is optional duplicate)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:hello@hostvia.me

# Optional email / Telegram (not required for app push)
# RESEND_API_KEY=re_xxxxxxxx
# BOOKING_NOTIFICATION_FROM=Hostvia <notifications@hostvia.me>
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_NOTIFY_CHAT_ID=your-chat-id

# Stripe — either three separate vars OR one bundled var (saves 2 Vercel slots):
# STRIPE_CONFIG=sk_live_xxx|whsec_xxx|price_xxx
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Admin panel (hostvia.me/admin)
# No Vercel env vars needed — run migration 031, then open /admin once to set a password.
# Optional legacy fallback: ADMIN_PANEL_PASSWORD or CRON_SECRET
